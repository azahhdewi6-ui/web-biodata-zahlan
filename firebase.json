{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "*.bat",
      "*.cmd",
      "*.sh",
      "*.exe",
      "README.md",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
